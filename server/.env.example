# MongoDB connection string (required for posts)
MONGODB_URL=

# OpenAI (required for POST /api/v1/dalle)
OPENAI_API_KEY=

# Optional: image model for openai.images.generate (defaults to gpt-image-1.5 in code)
OPENAI_IMAGE_MODEL=gpt-image-1.5

# Cloudinary (required for POST /api/v1/post — image upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
